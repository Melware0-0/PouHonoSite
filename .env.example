# .env.example — the settings Pou Hono reads at startup
# ------------------------------------------------------
# HOW TO USE THIS FILE
#   1. Copy it:  cp .env.example .env        (Windows: copy .env.example .env)
#   2. Fill in the two secrets below using the commands given.
#   3. Restart the server:  node server.js
#
# THIS file (.env.example) IS committed to git — it is only a template and
# contains no real secrets. Your .env is listed in .gitignore and must NEVER
# be committed, because it holds the real ones.
#
# If ADMIN_PASSWORD_HASH or SESSION_SECRET is missing, the server still
# starts and the public pages still work — but it prints a loud warning and
# admin login refuses every attempt ("fails closed"), rather than leaving the
# dashboard wide open.


# --- ADMIN_PASSWORD_HASH ------------------------------------------------
# A bcrypt HASH of the admin password — not the password itself.
#
# A hash is a one-way scramble: the server can check "does this guess hash
# to the same thing?", but nobody can turn the hash back into the password.
# So even someone who gets hold of this file cannot read the password out.
#
# Generate one (replace YourPasswordHere with the real password):
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" 'YourPasswordHere'
#
# The client brief says the admin password is `SACTH2027` for now, so for the
# proof of concept that command would be:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" 'SACTH2027'
#
# Paste the whole $2b$... string it prints on the line below.
# (Every run prints a DIFFERENT hash — that is normal and correct; bcrypt
# mixes in a random "salt" each time. Any of them will verify.)
ADMIN_PASSWORD_HASH=

# --- SESSION_SECRET -----------------------------------------------------
# A long random string used to SIGN the admin login cookie, so that a
# visitor cannot forge one by hand and let themselves in.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Treat it like a password. Changing it instantly logs everyone out.
SESSION_SECRET=

# --- PORT ---------------------------------------------------------------
# Optional. The port the server listens on. Defaults to 3000 if left blank.
PORT=3000

# --- EMAIL_ENABLED ------------------------------------------------------
# Confirmation emails (see email.js). Leave this false until an email
# provider is set up: while it is false, each confirmation is printed to the
# server console instead of being sent, so nothing goes out by accident.
#
# To turn emails on: set this to true, add EMAIL_FROM and your provider's
# key below, and fill in sendEmail() in email.js. README -> "Confirmation
# emails" has the steps. Setting it to true WITHOUT doing the email.js step
# just logs an error for each email — it never pretends to have sent one.
EMAIL_ENABLED=false

# The "From" line on confirmation emails. Must be an address your provider
# has verified for sending.
# EMAIL_FROM="SACTH NZ Tech Week <noreply@your-domain.nz>"

# Your provider's credentials go here too, e.g. SENDGRID_API_KEY=...
